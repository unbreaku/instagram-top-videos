# Tu API token de Apify. Sácalo en https://console.apify.com/settings/integrations
# Es OBLIGATORIO para que la app funcione.
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opcional) Cantidad máxima de posts a pedir por cuenta. Más alto = más caro y más lento.
# Por defecto 80 (suficiente para encontrar los top 20 videos).
APIFY_RESULTS_LIMIT=80
