# Tu API token de Apify. Sácalo en https://console.apify.com/settings/integrations
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase: del Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# Secret aleatorio para que solo Vercel pueda llamar al cron diario.
# Generar con: openssl rand -hex 32
CRON_SECRET=replace_with_random_hex

# Contraseña que protege /accounts y los endpoints que gastan dinero
# (scrape, analyze). Si no la pones, el modo se queda "abierto" (no recomendado
# en producción). Elige algo fuerte; vas a tipearla una sola vez por dispositivo.
OWNER_PASSWORD=cambiame_por_una_password_fuerte

# Deepgram: transcribe el audio de los reels. Free trial trae USD 200 de
# crédito. Sácala en https://console.deepgram.com/project/.../api-keys
DEEPGRAM_API_KEY=

# Anthropic (Claude Haiku): extrae hook, CTA y format_tags del transcript.
# Crea una en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx
